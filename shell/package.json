{
  "name": "actdsh",
  "productName": "actdsh",
  "description": "DeepSeek Harness 桌面壳（Electron），仅包装 dsh 原生功能",
  "version": "0.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "smoke": "electron runtime/node_modules/@deepseek-ai/dsh/lib/bin.js --help",
    "pack": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.0"
  },
  "build": {
    "appId": "io.github.turnx-alt.actdsh",
    "productName": "actdsh",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "loading.html",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "dsh",
        "filter": [
          "runtime/**"
        ]
      }
    ],
    "artifactName": "actdsh-${os}-${arch}-${version}.${ext}",
    "npmRebuild": false,
    "win": {
      "target": [
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "background": "build/background.png",
      "window": {
        "width": 680,
        "height": 480
      },
      "iconSize": 72,
      "contents": [
        {
          "x": 120,
          "y": 145
        },
        {
          "x": 560,
          "y": 145,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 200,
          "y": 420,
          "type": "file",
          "path": "build/双击我完成安装.command"
        },
        {
          "x": 470,
          "y": 420,
          "type": "file",
          "path": "build/请先读我.txt"
        }
      ]
    }
  }
}
